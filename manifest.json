{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/plugin-sdk-v1/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "io.github.icefoxs.aes-tools",
  "name": "aes-tools",
  "version": "0.1.2",
  "publisher": "icefoxs",
  "description": "基于 DBX 平台的 AES-128-ECB 加解密插件，兼容 Hutool 默认 AES 配置。（AES-128-ECB 为确定性加密、非语义安全）",
  "source": "https://github.com/IceFoxs/dbx-plugin-aes-tools",
  "homepage": "https://github.com/IceFoxs/dbx-plugin-aes-tools",
  "icon": "assets/plugin.svg",
  "engines": {
    "dbx": ">=0.6.31",
    "host_api": ">=1.0.0"
  },
  "entrypoints": {
    "backend": {
      "executable": "bin/dbx-plugin-aes-rust-plugin"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "permissions": [
    "host.clipboard:read",
    "host.workbench"
  ],
  "contributions": [
    {
      "type": "connection-provider",
      "id": "aes-tools.connection",
      "label": "aes-tools",
      "icon": "assets/plugin.svg",
      "database_type": "aes-rust-plugin",
      "description": "Connection form contributed by aes-tools.",
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "default": "aes-tools",
          "binding": "name",
          "required": true
        },
        {
          "key": "host",
          "label": "Host",
          "type": "text",
          "default": "localhost",
          "binding": "host",
          "required": true
        },
        {
          "key": "port",
          "label": "Port",
          "type": "number",
          "default": 8080,
          "binding": "port",
          "required": true
        },
        {
          "key": "protocol",
          "label": "协议",
          "type": "select",
          "binding": "config",
          "default": "https",
          "options": [
            {
              "label": "HTTPS",
              "value": "https"
            },
            {
              "label": "HTTP（内部网络）",
              "value": "http"
            }
          ]
        },
        {
          "key": "interface_path",
          "label": "接口地址",
          "type": "text",
          "binding": "config",
          "default": "/aesKeys",
          "required": true
        },
        {
          "key": "aes_key",
          "label": "aes key",
          "type": "text",
          "default": "1234567890123456",
          "binding": "config",
          "required": true
        },
        {
          "key": "aes_key_label",
          "label": "aes key label",
          "type": "textarea",
          "default": "[{\"label\":\"默认密钥\",\"value\":\"default_key\",\"aes_key\":\"1234567890123456\"}]",
          "binding": "config",
          "required": true
        }
      ],
      "workbench": "aes-tools.workbench",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ]
    },
    {
      "type": "workbench",
      "id": "aes-tools.workbench",
      "label": "aes-tools Workbench",
      "description": "Sandboxed UI contributed by aes-tools.",
      "icon": "assets/plugin.svg"
    }
  ],
  "localizations": {
    "zh-CN": {
